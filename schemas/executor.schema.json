{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/executor.schema.json",
  "title": "Executor Profile",
  "description": "A logical execution and artifact-storage target.",
  "type": "object",
  "x-schema-version": 1,
  "required": ["schema_version", "id", "executor", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "executor": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
