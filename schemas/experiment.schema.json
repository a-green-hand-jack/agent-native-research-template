{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/experiment.schema.json",
  "title": "Experiment Specification",
  "description": "Versioned intent for one reproducible research execution.",
  "type": "object",
  "x-schema-version": 1,
  "required": [
    "schema_version",
    "id",
    "question",
    "contribution",
    "config",
    "environment",
    "executor",
    "evaluation",
    "command",
    "seed_policy",
    "budget",
    "stopping_rule",
    "inclusion_criteria"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "question": {"type": "string", "minLength": 1},
    "contribution": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "config": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "executor": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "evaluation": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "command": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      ]
    },
    "seed_policy": {"type": "object"},
    "budget": {"type": "object"},
    "stopping_rule": {"type": "object"},
    "inclusion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
