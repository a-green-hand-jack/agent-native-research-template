{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/experiment.schema.json",
  "title": "Experiment Specification",
  "description": "Versioned intent for one reproducible research execution.",
  "type": "object",
  "x-schema-version": 1,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "command": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "path"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "path"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "uri"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "uri"
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "value"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "opaque"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "seed_policy": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "seeds"
          ],
          "properties": {
            "mode": {
              "const": "fixed"
            },
            "seeds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "count"
          ],
          "properties": {
            "mode": {
              "const": "random"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "start",
            "stop"
          ],
          "properties": {
            "mode": {
              "const": "range"
            },
            "start": {
              "type": "integer"
            },
            "stop": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "budget": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "max_runs": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_time_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_units": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "stopping_rule": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "runs"
          ],
          "properties": {
            "type": {
              "const": "after_runs"
            },
            "runs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "budget_exhausted"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "metric",
            "operator",
            "value"
          ],
          "properties": {
            "type": {
              "const": "metric_threshold"
            },
            "metric": {
              "$ref": "#/$defs/identifier"
            },
            "operator": {
              "enum": [
                ">",
                ">=",
                "<",
                "<=",
                "=="
              ]
            },
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "json_scalar": {
      "type": [
        "string",
        "integer",
        "number",
        "boolean",
        "null"
      ]
    },
    "asset_requirement": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "phase": {
          "enum": [
            "all",
            "generation",
            "evaluation"
          ]
        },
        "access": {
          "enum": [
            "read",
            "write"
          ]
        }
      },
      "additionalProperties": false
    },
    "phase_output": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "phase": {
      "type": "object",
      "required": [
        "id",
        "command"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "asset_phase": {
          "enum": [
            "all",
            "generation",
            "evaluation"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase_output"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "question",
    "contribution",
    "config",
    "environment",
    "executor",
    "evaluation",
    "command",
    "seed_policy",
    "budget",
    "stopping_rule",
    "inclusion_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "contribution": {
      "$ref": "#/$defs/identifier"
    },
    "config": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "$ref": "#/$defs/identifier"
    },
    "executor": {
      "$ref": "#/$defs/identifier"
    },
    "evaluation": {
      "$ref": "#/$defs/identifier"
    },
    "command": {
      "$ref": "#/$defs/command"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "seed_policy": {
      "$ref": "#/$defs/seed_policy"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "stopping_rule": {
      "$ref": "#/$defs/stopping_rule"
    },
    "inclusion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data": {},
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "protocol_id": {
      "$ref": "#/$defs/identifier"
    },
    "run_class": {
      "enum": [
        "smoke",
        "pilot",
        "partial",
        "reference",
        "formal",
        "post_observation"
      ]
    },
    "observation_status": {
      "enum": [
        "pre_observation",
        "post_observation"
      ]
    },
    "scientific_parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/json_scalar"
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/json_scalar"
        }
      }
    },
    "recovery_policy": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "new_run",
            "phase_retry"
          ]
        },
        "reuse_verified_artifacts": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "completion_criteria": {
      "type": "object",
      "properties": {
        "required_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset_requirement"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    }
  },
  "additionalProperties": true
}
