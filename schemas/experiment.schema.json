{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/experiment.schema.json",
  "title": "Experiment Specification",
  "description": "Versioned intent for one reproducible research execution.",
  "type": "object",
  "x-schema-version": 1,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "command": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    },
    "seed_policy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "seeds"],
          "properties": {
            "mode": {"const": "fixed"},
            "seeds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer"}
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "count"],
          "properties": {
            "mode": {"const": "random"},
            "count": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "start", "stop"],
          "properties": {
            "mode": {"const": "range"},
            "start": {"type": "integer"},
            "stop": {"type": "integer"}
          },
          "additionalProperties": false
        }
      ]
    },
    "budget": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "max_runs": {"type": "integer", "minimum": 1},
        "max_wall_time_seconds": {"type": "integer", "minimum": 1},
        "max_cost_units": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "stopping_rule": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "runs"],
          "properties": {
            "type": {"const": "after_runs"},
            "runs": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"const": "budget_exhausted"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "metric", "operator", "value"],
          "properties": {
            "type": {"const": "metric_threshold"},
            "metric": {"$ref": "#/$defs/identifier"},
            "operator": {"enum": [">", ">=", "<", "<=", "=="]},
            "value": {"type": "number"}
          },
          "additionalProperties": false
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "kind": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "question",
    "contribution",
    "config",
    "environment",
    "executor",
    "evaluation",
    "command",
    "seed_policy",
    "budget",
    "stopping_rule",
    "inclusion_criteria"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/identifier"},
    "question": {"type": "string", "minLength": 1},
    "contribution": {"$ref": "#/$defs/identifier"},
    "config": {"type": "string", "minLength": 1},
    "environment": {"$ref": "#/$defs/identifier"},
    "executor": {"$ref": "#/$defs/identifier"},
    "evaluation": {"$ref": "#/$defs/identifier"},
    "command": {"$ref": "#/$defs/command"},
    "seed_policy": {"$ref": "#/$defs/seed_policy"},
    "budget": {"$ref": "#/$defs/budget"},
    "stopping_rule": {"$ref": "#/$defs/stopping_rule"},
    "inclusion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "data": {},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "additionalProperties": true
}
