{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/archive-manifest.schema.json",
  "title": "Research Archive Manifest",
  "description": "Verified copies and retirement prerequisites for one immutable run.",
  "type": "object",
  "x-schema-version": 1,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "local_copy": {
      "type": "object",
      "required": [
        "method",
        "location",
        "fault_domain",
        "sha256",
        "file_count",
        "verified_at"
      ],
      "properties": {
        "method": {"const": "local_reread"},
        "location": {"type": "string", "minLength": 1},
        "fault_domain": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "verified_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "external_copy": {
      "type": "object",
      "required": [
        "method",
        "location",
        "fault_domain",
        "sha256",
        "file_count",
        "verified_at",
        "verifier",
        "evidence_uri"
      ],
      "properties": {
        "method": {"const": "external_attestation"},
        "location": {"type": "string", "minLength": 1},
        "fault_domain": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "verified_at": {"type": "string", "minLength": 1},
        "verifier": {"type": "string", "minLength": 1},
        "evidence_uri": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "required": ["archive_version", "run_id", "created_at", "source_manifest", "items"],
  "properties": {
    "archive_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "source_manifest": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source",
          "path_type",
          "sha256",
          "file_count",
          "reconstructable",
          "copies"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["run_artifact", "logical_asset"]},
          "logical_asset_id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "path_type": {"enum": ["file", "directory"]},
          "sha256": {"$ref": "#/$defs/sha256"},
          "file_count": {"type": "integer", "minimum": 1},
          "reconstructable": {"type": "boolean"},
          "copies": {
            "type": "array",
            "items": {
              "oneOf": [
                {"$ref": "#/$defs/local_copy"},
                {"$ref": "#/$defs/external_copy"}
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
