{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evaluation.schema.json",
  "title": "Evaluation Definition",
  "description": "A metric extraction protocol without an execution command.",
  "type": "object",
  "x-schema-version": 1,
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"const": "return_code"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "pattern"],
          "properties": {
            "type": {"const": "stdout_regex"},
            "pattern": {"type": "string", "minLength": 1},
            "group": {
              "oneOf": [
                {"type": "integer", "minimum": 0},
                {"type": "string", "minLength": 1}
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "path", "key"],
          "properties": {
            "type": {"const": "json_file"},
            "path": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "reason"],
          "properties": {
            "type": {"const": "missing"},
            "reason": {
              "enum": ["not_applicable", "not_measured", "empty_population", "evaluation_error"]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["schema_version", "id", "purpose", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/identifier"},
    "purpose": {"type": "string", "minLength": 1},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "direction",
          "source",
          "unit",
          "aggregation",
          "resource_mode",
          "sample_count",
          "observation_count"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "type": {"enum": ["boolean", "integer", "number", "string"]},
          "direction": {"enum": ["maximize", "minimize", "none"]},
          "source": {"$ref": "#/$defs/source"},
          "unit": {"type": "string", "minLength": 1},
          "aggregation": {"enum": ["single", "mean", "sum", "min", "max", "rate"]},
          "resource_mode": {
            "enum": [
              "single_process",
              "isolated_request",
              "multi_worker_wall_clock",
              "per_sequence",
              "per_token",
              "device_aggregate"
            ]
          },
          "sample_count": {"type": "integer", "minimum": 1},
          "observation_count": {"type": "integer", "minimum": 1},
          "dispersion": {
            "type": "object",
            "required": ["kind", "value"],
            "properties": {
              "kind": {
                "enum": [
                  "standard_deviation",
                  "standard_error",
                  "range",
                  "confidence_interval"
                ]
              },
              "value": {"type": "number"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
