{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evidence-manifest.schema.json",
  "title": "Evidence Manifest",
  "description": "A reviewed, immutable promotion envelope around one run manifest.",
  "type": "object",
  "x-schema-version": 1,
  "required": [
    "schema_version",
    "evidence_version",
    "run_id",
    "promoted_at",
    "source",
    "review",
    "manifest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "promoted_at": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["path", "sha256"]
    },
    "review": {
      "type": "object",
      "required": ["decision", "note"],
      "properties": {
        "decision": {"enum": ["accepted", "rejected", "inconclusive"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "manifest": {"type": "object"}
  },
  "additionalProperties": false
}
