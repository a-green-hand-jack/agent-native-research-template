{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/template-plan.schema.json",
  "title": "Template Lifecycle Plan",
  "type": "object",
  "x-schema-version": 1,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "minLength": 1}
  },
  "required": [
    "plan_version",
    "mode",
    "template",
    "downstream",
    "changes",
    "plan_sha256"
  ],
  "properties": {
    "plan_version": {"const": 1},
    "mode": {"enum": ["adoption", "update"]},
    "template": {
      "type": "object",
      "required": ["repository", "baseline_commit", "target_commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "baseline_commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "target_commit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "downstream": {
      "type": "object",
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "dirty": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "upstream_change", "ownership", "disposition", "operation"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "upstream_change": {"enum": ["added", "modified", "deleted", "present"]},
          "ownership": {"enum": ["template-owned", "shared/customized", "not-present"]},
          "disposition": {"enum": ["safe", "already", "manual", "conflict"]},
          "operation": {"enum": ["write", "delete", "noop", "review"]}
        },
        "additionalProperties": false
      }
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false
}
