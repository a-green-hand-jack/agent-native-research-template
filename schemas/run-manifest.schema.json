{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/run-manifest.schema.json",
  "title": "Run Manifest",
  "description": "Immutable observed facts from one experiment execution.",
  "type": "object",
  "x-schema-version": 1,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path_hash": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolved": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "required": [
        "id",
        "definition",
        "definition_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "definition_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": true
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "path",
            "path_type",
            "sha256",
            "file_count"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "path"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "path_type": {
              "enum": [
                "file",
                "directory"
              ]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "file_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "uri"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "uri"
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "value"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "opaque"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "metric_observation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "value",
            "unit",
            "sample_count",
            "aggregation",
            "resource_mode",
            "observation_count"
          ],
          "properties": {
            "state": {
              "const": "measured"
            },
            "value": {
              "type": [
                "boolean",
                "integer",
                "number",
                "string"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "sample_count": {
              "type": "integer",
              "minimum": 1
            },
            "aggregation": {
              "enum": [
                "single",
                "mean",
                "sum",
                "min",
                "max",
                "rate"
              ]
            },
            "resource_mode": {
              "enum": [
                "single_process",
                "isolated_request",
                "multi_worker_wall_clock",
                "per_sequence",
                "per_token",
                "device_aggregate"
              ]
            },
            "observation_count": {
              "type": "integer",
              "minimum": 1
            },
            "dispersion": {
              "type": "object"
            },
            "legacy": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "missing_reason",
            "unit",
            "sample_count",
            "aggregation",
            "resource_mode",
            "observation_count"
          ],
          "properties": {
            "state": {
              "const": "missing"
            },
            "missing_reason": {
              "enum": [
                "not_applicable",
                "not_measured",
                "empty_population",
                "evaluation_error"
              ]
            },
            "detail": {
              "type": "string"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "sample_count": {
              "type": "integer",
              "minimum": 1
            },
            "aggregation": {
              "enum": [
                "single",
                "mean",
                "sum",
                "min",
                "max",
                "rate"
              ]
            },
            "resource_mode": {
              "enum": [
                "single_process",
                "isolated_request",
                "multi_worker_wall_clock",
                "per_sequence",
                "per_token",
                "device_aggregate"
              ]
            },
            "observation_count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "parent_run_id",
    "status",
    "started_at",
    "finished_at",
    "return_code",
    "termination",
    "seed",
    "seed_environment_variable",
    "question",
    "contribution",
    "plan",
    "config",
    "data",
    "asset_bindings",
    "spec",
    "git",
    "environment",
    "executor",
    "evaluation",
    "hardware",
    "phases",
    "recovery",
    "metrics",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "return_code": {
      "type": "integer"
    },
    "termination": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "const": "completed"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "reason",
            "max_wall_time_seconds"
          ],
          "properties": {
            "reason": {
              "const": "timeout"
            },
            "max_wall_time_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "const": "phase_failed"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "seed": {
      "type": "integer"
    },
    "seed_environment_variable": {
      "const": "RESEARCH_SEED"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "contribution": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "$ref": "#/$defs/path_hash"
    },
    "data": {},
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "resolved"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolved": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "required": [
        "commit",
        "dirty",
        "status",
        "patch_sha256"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "status": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patch_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "allOf": [
        {
          "$ref": "#/$defs/definition"
        },
        {
          "type": "object",
          "required": [
            "lockfile",
            "lockfile_sha256"
          ],
          "properties": {
            "lockfile": {
              "type": "string",
              "minLength": 1
            },
            "lockfile_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "executor": {
      "$ref": "#/$defs/definition"
    },
    "evaluation": {
      "$ref": "#/$defs/definition"
    },
    "hardware": {
      "type": "object",
      "required": [
        "platform",
        "machine",
        "processor",
        "cpu_count"
      ],
      "properties": {
        "platform": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "processor": {
          "type": "string"
        },
        "cpu_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metric_observation"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "evaluation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "sha256",
        "resolved"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolved": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "asset_bindings": {
      "type": "object",
      "required": [
        "phase",
        "assets",
        "sha256"
      ],
      "properties": {
        "phase": {
          "enum": [
            "all",
            "generation",
            "evaluation"
          ]
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "depends_on",
          "asset_phase",
          "command",
          "return_code",
          "started_at",
          "finished_at",
          "termination",
          "asset_bindings",
          "artifacts",
          "errors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "incomplete",
              "reused"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asset_phase": {
            "enum": [
              "all",
              "generation",
              "evaluation"
            ]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "return_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "termination": {
            "type": "object"
          },
          "asset_bindings": {
            "type": "object"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifact"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_run_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "recovery": {
      "type": "object",
      "required": [
        "mode",
        "retry_phase",
        "source_run_id",
        "reused_artifacts",
        "generation_skipped"
      ],
      "properties": {
        "mode": {
          "enum": [
            "new_run",
            "phase_retry"
          ]
        },
        "retry_phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reused_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "generation_skipped": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
