{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/run-manifest.schema.json",
  "title": "Run Manifest",
  "description": "Immutable observed facts from one experiment execution.",
  "type": "object",
  "x-schema-version": 1,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "started_at",
    "finished_at",
    "return_code",
    "spec",
    "git",
    "environment",
    "executor",
    "evaluation",
    "command",
    "metrics",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "return_code": {
      "type": "integer"
    },
    "metrics": {
      "type": "object"
    },
    "artifacts": {
      "type": "array"
    },
    "evaluation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
