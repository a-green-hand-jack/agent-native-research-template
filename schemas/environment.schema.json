{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/environment.schema.json",
  "title": "Environment Definition",
  "description": "A reproducible dependency-set identity.",
  "type": "object",
  "x-schema-version": 1,
  "required": ["schema_version", "id", "backend", "lockfile", "purpose"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "backend": {"type": "string", "minLength": 1},
    "lockfile": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
