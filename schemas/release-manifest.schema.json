{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/release-manifest.schema.json",
  "title": "Immutable Release Manifest",
  "type": "object",
  "x-schema-version": 1,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repoPath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "factSnapshot": {
      "type": "object",
      "required": ["id", "path", "sha256", "source_url", "checked_at", "valid_until", "declared_status", "effective_status", "scope"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "path": {"$ref": "#/$defs/repoPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_url": {"type": "string", "pattern": "^https://"},
        "checked_at": {"type": "string", "minLength": 1},
        "valid_until": {"type": ["string", "null"]},
        "declared_status": {"enum": ["VERIFIED", "UNVERIFIED", "UNKNOWN"]},
        "effective_status": {"enum": ["VERIFIED", "UNVERIFIED", "UNKNOWN", "STALE"]},
        "scope": {"type": "array", "items": {"enum": ["toolchain", "platform", "api", "dataset", "model", "access", "hardware"]}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "release_version",
    "release_id",
    "created_at",
    "profile",
    "source",
    "artifact",
    "verification",
    "external_facts",
    "release_ready",
    "approval"
  ],
  "properties": {
    "release_version": {"const": 1},
    "release_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "profile": {
      "type": "object",
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/repoPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["git_revision", "dirty_state_sha256"],
      "properties": {
        "git_revision": {"type": "string", "minLength": 1},
        "dirty_state_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "file_count"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["commands", "passed", "verified_at"],
      "properties": {
        "commands": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "passed": {"type": "boolean"},
        "verified_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "external_facts": {"type": "array", "items": {"$ref": "#/$defs/factSnapshot"}},
    "release_ready": {"type": "boolean"},
    "approval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["approved_by", "approved_at", "draft_manifest_sha256"],
          "properties": {
            "approved_by": {"type": "string", "minLength": 1},
            "approved_at": {"type": "string", "minLength": 1},
            "draft_manifest_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"release_ready": {"const": true}}},
      "then": {"properties": {"approval": {"type": "object"}}},
      "else": {"properties": {"approval": {"type": "null"}}}
    }
  ],
  "additionalProperties": false
}
