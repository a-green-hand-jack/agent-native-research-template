{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/external-fact.schema.json",
  "title": "External Fact Observation",
  "type": "object",
  "x-schema-version": 1,
  "required": ["schema_version", "id", "statement", "source_url", "checked_at", "status", "scope"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "statement": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "pattern": "^https://"},
    "checked_at": {"type": "string", "minLength": 1},
    "valid_until": {"type": "string", "minLength": 1},
    "status": {"enum": ["VERIFIED", "UNVERIFIED", "UNKNOWN"]},
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["toolchain", "platform", "api", "dataset", "model", "access", "hardware"]}
    },
    "verification_method": {"type": "string", "minLength": 1},
    "evidence_uri": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "VERIFIED"}}},
      "then": {"required": ["valid_until", "verification_method"]}
    }
  ],
  "additionalProperties": false
}
